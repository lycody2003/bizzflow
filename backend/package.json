{
  "name": "bizzflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Business Management API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:pm2": "pm2-dev start src/server.ts --interpreter ./node_modules/.bin/tsx",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "migrate:product-skus": "tsx scripts/migrations/migrate-product-skus.ts",
    "migrate:variant-combination-keys": "tsx scripts/migrations/migrate-variant-combination-keys.ts",
    "migrate:inventory-indexes": "tsx scripts/migrations/migrate-inventory-indexes.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}

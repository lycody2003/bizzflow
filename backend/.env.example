
# Application
APP_NAME=BizzFlow
APP_VERSION=1.0.0
NODE_ENV=development
PORT=5050

# API
API_PREFIX=/api
API_VERSION=v1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=bizzflow
MONGODB_TEST_DATABASE=bizzflow_test

# Frontend
CORS_ORIGIN=http://localhost:3003

# Authentication
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_REFRESH_EXPIRES_IN_MINUTES=2

BCRYPT_SALT_ROUNDS=12
CSRF_SECRET=replace_with_a_random_secret_at_least_32_characters

CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
